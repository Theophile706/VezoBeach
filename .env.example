# API Configuration
VITE_API_URL=http://localhost:4000/api

# Service d'envoi des demandes par e-mail (server/), sans /api.
# En développement, laisser vide : Vite redirige /api vers localhost:4100.
# En production, indiquer l'URL publique du serveur.
# VITE_REQUESTS_API_URL=https://votre-serveur-de-demandes

# Adresse publique du site, sans barre finale.
# Elle sert aux URL absolues des balises de partage (og:image, canonical) et aux
# données structurées : un chemin relatif n'y fonctionne pas, les robots des
# réseaux sociaux ne le résolvent pas.
VITE_SITE_URL=https://www.royalpalaceantsirabe.com
